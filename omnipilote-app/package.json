{
  "name": "omnipilote",
  "productName": "OmniPilote",
  "version": "1.0.0",
  "description": "OmniPilote – tableau de bord OmniService Sud Corse",
  "author": "OmniService Sud Corse",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "corsica.omniservice.omnipilote",
    "productName": "OmniPilote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "OmniPilote-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OmniPilote",
      "artifactName": "OmniPilote-${version}-installation.${ext}"
    },
    "portable": {
      "artifactName": "OmniPilote-${version}-portable.exe"
    }
  }
}
